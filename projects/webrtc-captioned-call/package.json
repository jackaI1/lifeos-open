{
  "name": "webrtc-captioned-call",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup:models": "node scripts/setup-assets.mjs",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "@huggingface/transformers": "^4.3.2",
    "sirv": "^3.0.2",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
