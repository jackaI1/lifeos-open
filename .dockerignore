# Keep the build context small and free of local state or secrets.
.git
node_modules
build
dist
coverage
.local
.runtime
.lifeos*
data
uploads
backups
recordings
transcripts
exports
.env
.env.*
!.env.example
*.sqlite
*.sqlite-*
*.db
*.log
.cache
.DS_Store
playwright-report
test-results
wrangler.jsonc
wrangler.toml
.dev.vars
.wrangler
# Not needed to build or run the standalone server image.

# Operator-owned AWS state/plans must never enter any Docker build stage.
infra/aws/.terraform
infra/aws/*.tfstate
infra/aws/*.tfstate.*
infra/aws/*.tfvars
infra/aws/*.tfplan

# Independent integrations have their own dependencies and local settings.
**/node_modules
**/dist
**/.env
**/.env.*
!**/.env.example
**/local.settings.json
integrations/azure-feed/infra/*.bicepparam
integrations/azure-feed/infra/*.parameters.json

# Optional study tools are built by their own workflows.
projects

**/.terraform
**/bin
**/obj
**/__pycache__
**/.pytest_cache
**/.venv

**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfplan
