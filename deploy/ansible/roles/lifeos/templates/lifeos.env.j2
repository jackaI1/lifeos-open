# LifeOS environment, read by systemd (KEY=value, no quotes or export).
# Managed by the Ansible role in deploy/ansible. Edit a variable there and re-run the playbook.
PORT={{ lifeos_port }}
APP_ORIGIN={{ lifeos_app_origin }}
# local = sign in with LOCAL_ACCESS_TOKEN; demo = no sign-in (loopback only, fictional data)
AUTH_MODE=local
LOCAL_ACCESS_TOKEN={{ lifeos_access_token }}
DEMO_SEED={{ 'true' if lifeos_demo_seed | bool else 'false' }}
LIFEOS_DATABASE={{ lifeos_state_dir }}/workspace.sqlite
LLM_MODE=mock
GOOGLE_MODE=local
