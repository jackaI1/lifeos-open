{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": ["integrations/azure-feed", "integrations/payments"],
  "include": [
    "src/local/**/*.ts",
    "src/hosted/**/*.ts",
    "src/analytics/**/*.ts",
    "integrations/**/*.ts"
  ]
}
