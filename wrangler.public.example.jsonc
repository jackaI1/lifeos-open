{
  "name": "lifeos-open-demo",
  "main": "src/hosted/worker.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "build": {"command":"node tools/build-hosted-assets.mjs"},
  "assets": {
    "directory":".runtime/hosted/assets",
    "binding":"ASSETS",
    "run_worker_first":["/", "/index.html", "/api", "/api/*", "/auth", "/auth/*"],
    "html_handling":"none",
    "not_found_handling":"none"
  },
  "vars": {"DEMO_ORIGIN":"https://demo.example.invalid","PARENT_ORIGIN":"https://owner.example.invalid"},
  "observability": {"enabled":false}
}
