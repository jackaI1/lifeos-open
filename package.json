{
  "name": "lifeos-open",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/local/main.ts",
    "start": "node --env-file-if-exists=.env build/server.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs integrations/m365/test/*.test.ts && npm run test:react",
    "test:whisper": "node --test test/whisper-inference.integration.mjs",
    "analytics:check": "node tools/analytics-check.mjs",
    "lint": "eslint src public demo tools test integrations",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend/react",
    "test:smoke": "node tools/smoke.mjs",
    "privacy": "node tools/privacy.mjs",
    "restore": "node tools/restore.mjs",
    "m365": "node --env-file-if-exists=.env integrations/m365/src/cli.ts",
    "m365:pack-flow": "node integrations/m365/flow/pack.ts",
    "test:e2e": "node tools/e2e.mjs",
    "db:import": "node --env-file-if-exists=.env tools/sqlite-to-postgres.mjs",
    "test:react": "vitest run",
    "experiment:report": "node tools/experiment-report.mjs",
    "test:cache": "node --test test/redis-cache.test.mjs",
    "benchmark:cache": "node tools/cache-benchmark.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "d3-axis": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "google-auth-library": "11.0.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
