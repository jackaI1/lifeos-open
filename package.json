{
  "name": "lifeos-open",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/local/main.ts",
    "start": "node --env-file-if-exists=.env build/server.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.mjs integrations/m365/test/*.test.ts && npm run test:react",
    "test:whisper": "node --test test/whisper-inference.integration.mjs",
    "analytics:check": "node tools/analytics-check.mjs",
    "lint": "eslint src public demo tools test integrations",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/frontend/react",
    "test:smoke": "node tools/smoke.mjs",
    "privacy": "node tools/privacy.mjs",
    "theme:figma": "node tools/figma-theme.mjs",
    "restore": "node tools/restore.mjs",
    "m365": "node --env-file-if-exists=.env integrations/m365/src/cli.ts",
    "m365:pack-flow": "node integrations/m365/flow/pack.ts",
    "test:e2e": "node tools/e2e.mjs",
    "export:project": "node tools/export-school-project.mjs",
    "db:import": "node --env-file-if-exists=.env tools/sqlite-to-postgres.mjs",
    "test:react": "vitest run",
    "test:kubernetes": "node --test test/kubernetes.integration.mjs",
    "experiment:report": "node tools/experiment-report.mjs",
    "test:cache": "node --test test/redis-cache.test.mjs",
    "benchmark:cache": "node tools/cache-benchmark.mjs",
    "test:ci": "node --test --test-reporter=junit --test-reporter-destination=test-results/node.xml test/*.test.mjs integrations/m365/test/*.test.ts && npm run test:react -- --reporter=default --reporter=junit --outputFile.junit=test-results/react.xml",
    "jenkins:lint": "node tools/jenkins-lint.mjs",
    "notes": "node --env-file-if-exists=.env src/notes/cli.mjs",
    "test:notes": "node --test test/notes-question.test.mjs",
    "rag:download": "node tools/retrieval-download.mjs",
    "rag:evaluate": "node tools/retrieval-evaluate.mjs",
    "test:rag": "node --test test/retrieval.test.mjs test/retrieval.integration.mjs && npm run rag:evaluate",
    "test:rag:browser": "node --test tools/retrieval-browser.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "test:api": "node tools/run-api-tests.mjs",
    "test:selenium": "node tools/run-selenium-tests.mjs",
    "support": "node --env-file-if-exists=.env src/support/cli.mjs",
    "support:evaluate": "node tools/support-evaluate.mjs",
    "test:support": "node --test test/support-assistant.test.mjs test/azure-provider.test.mjs",
    "test:azure": "node --test deploy/azure/test/healthcheck.test.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.2",
    "@huggingface/transformers": "4.3.2",
    "@langchain/core": "1.3.5",
    "@langchain/ollama": "1.3.0",
    "@langchain/textsplitters": "1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "d3-axis": "3.0.0",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "google-auth-library": "11.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.1",
    "sqlite-vec": "^0.1.9",
    "web-push": "3.6.7",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.1",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.3",
    "newman": "^6.2.3",
    "playwright": "^1.56.0",
    "robots-parser": "^3.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "license": "MIT"
}
