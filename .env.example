# Placeholder configuration. Defaults work without credentials.
PORT=8787
AUTH_MODE=demo
DEMO_SEED=true
LIFEOS_DATABASE=.local/workspace.sqlite
# Optional self-hosted PostgreSQL; takes precedence over LIFEOS_DATABASE.
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
# Optional Redis cache for saved-record API reads; empty means off.
# REDIS_URL=redis://127.0.0.1:6379
LLM_MODE=mock
GOOGLE_MODE=local
# Optional saved-text answers. Download the local model with npm run rag:download first.
# RAG_MODE=local
# RAG_THRESHOLD=0.40
# RAG_DATABASE=.local/retrieval.sqlite
# RAG_MODEL_CACHE=.cache/retrieval-model
# Set for optional authenticated local mode; use at least 24 random characters.
# LOCAL_ACCESS_TOKEN=YOUR_LOCAL_ACCESS_TOKEN
# Optional OpenAI-compatible provider. Choosing real sends messages to this endpoint.
# LLM_BASE_URL=https://YOUR_LLM_HOST/v1
# LLM_API_KEY=YOUR_LLM_API_KEY
# LLM_MODEL=YOUR_LLM_MODEL
# LLM_MODELS=YOUR_EXTRA_MODEL,ANOTHER_MODEL
# Optional Azure OpenAI uses the resource root and deployment name instead.
# Set LLM_MODE=real only when ready to send selected passages to this endpoint.
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com
# LLM_MODEL=YOUR_DEPLOYMENT_NAME
# LLM_API_KEY=YOUR_AZURE_OPENAI_KEY
# AZURE_OPENAI_API_VERSION=2024-10-21
# Optional outbound link origins, shown only with GOOGLE_MODE=real.
# EXTERNAL_LINK_ORIGINS=https://YOUR_CONFIGURED_SERVICE
# Optional Google OAuth and Drive services.
# ALLOWED_EMAIL=YOUR_ALLOWED_EMAIL
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
# APP_ORIGIN=http://127.0.0.1:8787
# APP_CONFIG=YOUR_JSON_CONFIGURATION

# Optional offline lecture transcription. See docs/whisper.md for model setup.
# WHISPER_PYTHON=.local/whisper-venv/bin/python
# WHISPER_MODEL=base.en
# WHISPER_LANGUAGE=en

# Optional privacy-gate patterns stored outside the published project.
# LIFEOS_PRIVACY_PATTERNS=YOUR_EXTERNAL_PATTERN_FILE

# Optional retained worker / institution adapters. Defaults use fictional hosts.
# LIFEOS_CLOUD_ORIGIN=YOUR_HTTPS_APP_ORIGIN

# Optional isolated beta deployment (hosted/gateway configurations only).
# BETA_ORIGIN=YOUR_HTTPS_BETA_ORIGIN

# Optional Microsoft 365 sync (SharePoint list via Microsoft Graph). See integrations/m365/README.md.
# M365_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_ID
# M365_TENANT_ID=YOUR_TENANT_ID_OR_organizations
# M365_SITE_URL=https://YOUR-TENANT.sharepoint.com/sites/YOUR-SITE
# M365_LIST_NAME=LifeOS Tasks

# Public DEMO asset build only (never enables analytics in the private/local app).
# See docs/analytics.md. Placeholders keep analytics off; set real IDs in the public build environment.
# LIFEOS_GTM_ID=GTM-XXXXXXX
# LIFEOS_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional local note questions: see docs/notes-questions.md.
# Both model names must already be pulled in Ollama.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# NOTES_EMBED_MODEL=nomic-embed-text
# NOTES_CHAT_MODEL=qwen2.5:1.5b
# NOTES_MIN_SCORE=0.65
# NOTES_INDEX=.local/notes-index.sqlite
